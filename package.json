{
  "name": "tradingjournal",
  "productName": "Trading Journal",
  "version": "1.6.0",
  "description": "Persönliches Trading-Journal – Desktop (Electron) und Handy (PWA)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "npx serve app",
    "package-win": "electron-packager . TradingJournal --platform=win32 --arch=x64 --icon=app/icon.ico --out=dist --overwrite",
    "package-linux": "electron-packager . tradingjournal --platform=linux --arch=x64 --icon=app/icon.png --out=dist --overwrite --ignore=\"^/(dist|docs|\\.github|README\\.md|build-deb\\.js)\"",
    "build-deb": "npm run package-linux && node build-deb.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-installer-debian": "^4.0.0",
    "electron-packager": "^17.1.2"
  }
}
